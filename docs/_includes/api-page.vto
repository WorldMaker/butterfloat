---
layout: main.vto
---

<section class="section page-content">
    <nav class="menu toc-menu" toc="page-content">
        <p class="menu-label">
            Table of Contents
            {{ if tags.includes('preview') }}
            <span class="icon" title="Preview"><i class="fa-duotone fa-regular fa-flux-capacitor fa-2x"></i></span>
            {{ /if }}
        </p>
    </nav>

    <article class="container content" id="page-content">
        {{ content }}
    </article>

    {{ include "paginator.vto" { searchTag: 'api' } }}
</section>

<nav class="menu page-menu">
    <p class="menu-label">Butterfloat API</p>
    <ul class="menu-list">
        {{ for item of nav.menu("/", "api").children }}
        <li>
            {{ include "menu-item.vto" { item } }}
        </li>
        {{ /for }}
    </ul>
</nav>
