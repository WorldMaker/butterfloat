---
layout: main.vto
---

<nav class="breadcrumb">
    <ul>
        {{ for item of nav.breadcrumb(url) }}
        <li>
            {{ if item.data }}
            <a href="{{ item.data.url }}">{{ item.data.title }}</a>
            {{ else }}
            <span>{{ item.slug }}</span>
            {{ /if }}
        </li>
        {{ /for }}
    </ul>
</nav>

<section class="section page-content">
    <nav class="menu toc-menu" toc="page-content">
        <p class="menu-label">Table of Contents</p>
    </nav>

    <article class="container content" id="page-content">
        {{ content }}
    </article>

    {{ include "paginator.vto" { searchTag: 'stable' } }}
</section>

<nav class="menu page-menu">
    <p class="menu-label">Butterfloat</p>
    <ul class="menu-list">
        {{ for item of nav.menu("/", "stable").children }}
        <li>
            {{ include "menu-item.vto" { item } }}
        </li>
        {{ /for }}
    </ul>
</nav>
