{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-plugin-frontmatter",
    "./_typedoc-frontmatter.js"
  ],
  "out": "./docs/v2/types/",
  "readme": "none",
  "entryPoints": [
    "./v2/index.ts",
    "./v2/svg/index.ts",
    "./v2/testing/index.ts"
  ],
  "entryFileName": "index",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "frontmatterGlobals": {
    "layout": "preview-page.vto",
    "order": 200,
    "tags": ["preview"]
  }
}
